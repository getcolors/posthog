#!/usr/bin/env bash
set -euo pipefail
cd /opt/posthog
stamp=$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p "/var/backups/posthog"

# 1. Logical PostgreSQL backup
docker compose exec -T db pg_dump -U posthog posthog | gzip > "/var/backups/posthog/postgres-$stamp.sql.gz"

# 2. ClickHouse metadata and data snapshot
docker compose exec -T clickhouse tar -czf - /var/lib/clickhouse/metadata /var/lib/clickhouse/data 2>/dev/null > "/var/backups/posthog/clickhouse-$stamp.tar.gz" || tar -czf "/var/backups/posthog/clickhouse-$stamp.tar.gz" -C "/var/lib/posthog/clickhouse" .

# 3. Offsite synchronization to Cloudflare R2
RCLONE_CONFIG_R2_TYPE=s3 \
RCLONE_CONFIG_R2_PROVIDER=Cloudflare \
RCLONE_CONFIG_R2_REGION=auto \
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true \
RCLONE_CONFIG_R2_ACCESS_KEY_ID="$POSTHOG_BACKUP_R2_ACCESS_KEY_ID" \
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$POSTHOG_BACKUP_R2_SECRET_ACCESS_KEY" \
RCLONE_CONFIG_R2_ENDPOINT="https://319271fed8bc6d2d9059362be1165f37.eu.r2.cloudflarestorage.com" \
rclone copyto "/var/backups/posthog/postgres-$stamp.sql.gz" \
  "r2:posthog-backup/posthog-fixture/postgres-$stamp.sql.gz"

RCLONE_CONFIG_R2_TYPE=s3 \
RCLONE_CONFIG_R2_PROVIDER=Cloudflare \
RCLONE_CONFIG_R2_REGION=auto \
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true \
RCLONE_CONFIG_R2_ACCESS_KEY_ID="$POSTHOG_BACKUP_R2_ACCESS_KEY_ID" \
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$POSTHOG_BACKUP_R2_SECRET_ACCESS_KEY" \
RCLONE_CONFIG_R2_ENDPOINT="https://319271fed8bc6d2d9059362be1165f37.eu.r2.cloudflarestorage.com" \
rclone copyto "/var/backups/posthog/clickhouse-$stamp.tar.gz" \
  "r2:posthog-backup/posthog-fixture/clickhouse-$stamp.tar.gz"

# 4. Retention cleanup
find "/var/backups/posthog" -type f \( -name 'postgres-*.sql.gz' -o -name 'clickhouse-*.tar.gz' \) -mtime +7 -delete
