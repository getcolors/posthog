# Behind the Cloudflare proxy every connection arrives from an edge address, so
# without this Caddy attributes each request to Cloudflare: the access log
# records the proxy rather than the visitor. The applications read
# X-Forwarded-For themselves, so this changes what Caddy sees and logs, not
# what they store.
{
  servers {
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
  }
}

posthog.example.com {
  encode zstd gzip
  # Access logging is off by default in Caddy, so only errors and TLS events
  # were recorded and a successful request left no trace anywhere. Ingestion
  # was undebuggable: there was no request-level evidence that an event ever
  # reached capture. Logs go to stdout, which is where docker logs reads, and
  # the compose service bounds them so a busy endpoint cannot fill the disk.
  log {
    output stdout
    format json
  }
  # Ingestion goes to the capture service; everything else is the application.
  @capture path /capture /capture/* /e /e/* /batch /batch/* /i/* /track /track/* /engage /engage/* /s /s/*
  handle @capture {
    reverse_proxy capture:3000
  }

  handle {
    reverse_proxy web:8000
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
}
