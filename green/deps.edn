{:paths ["src/clj" "src/resources"]
 :deps {org.clojure/clojure       {:mvn/version "1.12.5"}
        io.github.getcolors/green {:git/url "https://github.com/getcolors/green.git"
                                   :git/sha "3f33f5d4dcce1f8d97a11b6972e13eb3f0b37654"}
        ;; 417d5f7 is where ONCE gained `compute`, the Compute Provider
        ;; Standard's operations this package delegates to; 38e3cd6, the pin,
        ;; is where its `read-state` trusts the SDK's step error alone as the
        ;; unreadable-backend shape, which needs green 3f33f5d above — the
        ;; SDK that reports a `tofu output` launch failure (a missing stage
        ;; directory on a fresh clone) as that step error, so a create there
        ;; reports its missing credentials instead of crashing; the two pins
        ;; move together. bc06f2f, below all of them, is where ONCE moved the
        ;; machine keypair into the operator's ~/.ssh. The pin cannot go below
        ;; any of them.
        io.github.getcolors/once  {:git/url "https://github.com/getcolors/once.git"
                                   :git/sha "38e3cd66674a32fb96605e1b17ae6791086ad5c1"
                                   :deps/root "green"}}
 :aliases {:dev {:extra-paths ["test/clj" "test/resources"]}
           :test {:extra-paths ["test/clj" "test/resources"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}}}
